{
  "name": "@course-kb/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "create-admin": "node src/auth/create-admin.ts",
    "test": "node --test --test-force-exit --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:backend": "node --test --test-force-exit --test-concurrency=1 test/store_*.test.ts test/routes_*.test.ts test/rbac_*.test.ts test/sse_*.test.ts test/worker_*.test.ts",
    "test:worker": "node --test --test-force-exit test/worker_framing.test.ts",
    "test:e2e:agent": "node --test --test-force-exit test/e2e/agent_kb.e2e.ts",
    "test:e2e:audio": "node test/e2e/openrouter_audio.e2e.mjs",
    "test:e2e:ocr": "node test/e2e/openrouter_ocr.e2e.mjs",
    "test:e2e:bootstrap": "node test/e2e/bootstrap_admin.e2e.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.1.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.4.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
