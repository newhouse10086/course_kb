{
  "name": "@course-kb/web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "course-kb Vue3 + Vite 前端（五视图：Wiki 知识库 / 图谱 / 视频课堂 / pi 助教 / 文档管理）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "vite build --logLevel warn && python test/chrome_dom.py",
    "test:perf": "vite build --logLevel warn && python test/perf_report.py",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "katex": "^0.16.47",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.13",
    "ws": "^8.22.0"
  }
}
